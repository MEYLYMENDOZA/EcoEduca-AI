# EcoEduca-AI Backend — variables de entorno de ejemplo
NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://ecoeduca:ecoeduca_pass@localhost:5432/ecoeduca?schema=public"

JWT_SECRET="cambia-este-valor-en-produccion"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"

# Generación de contenido con IA (Gemini) a partir del material (PDF/Word) que
# sube el docente para un tema/semana. Clave gratuita (free tier, sin tarjeta
# de crédito) en https://aistudio.google.com/apikey
GEMINI_API_KEY=
